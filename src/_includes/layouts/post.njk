<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "partials/head.njk" %}
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}
    <meta property="og:title" content="{{ title }}">
    {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
    {% if cover %}<meta property="og:image" content="{{ cover }}">{% endif %}
  </head>
  <body class="bg-white text-slate-800">
    {% include "partials/header.njk" %}

    <!-- TOP SECTION (title/meta/cover) -->
    <section class="mx-auto max-w-7xl px-6 pt-8">
      <a href="{{ '/blog' | url }}" class="inline-flex items-center gap-2 text-sm text-slate-600 hover:text-brand.dark">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="m14 7-5 5 5 5V7z"/></svg>
        Back to all posts
      </a>
      <h1 class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight text-sky-600">{{ title }}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-slate-600">
        <span>{{ date | readableDate }}</span>
        <span>•</span>
        <span>{{ content | readingTime }}</span>
        {% if tags and tags.length %}<span>•</span>{% for tag in tags %}
          <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-3 py-1.5 text-sm text-slate-700">{{ tag }}</span>
        {% endfor %}{% endif %}
      </div>

      {% if cover %}
      <div class="relative mt-6 overflow-hidden rounded-3xl bg-slate-100">
        <img src="{{ cover }}" alt="{{ title }}" class="w-full object-cover object-center max-h-[200px]"/>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-b from-transparent to-white"></div>
      </div>
      {% endif %}
    </section>

    <!-- CONTENT + SIDEBAR -->
    <main class="mx-auto max-w-7xl px-6 pb-20">
      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_320px]">
        <!-- Article -->
        <article class="prose max-w-none">
          {{ content | safe }}
          <hr class="my-10 border-slate-200">
          <p class="text-sm text-slate-500">Spotted a typo? <a href="#" class="underline">Open a PR</a> or <a href="{{ '/index.html#contact' | url }}" class="underline">send me a note</a>.</p>
        </article>

        <!-- Sidebar -->
        <aside class="lg:pl-6">
          <!-- TOC -->
          <div class="rounded-3xl bg-white p-6 shadow-soft ring-1 ring-slate-100">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500">On this page</h3>
            {% if toc and toc.length %}
              <ol class="mt-3 space-y-2 toc list-decimal pl-5">
                {% for item in toc %}
                  <li><a class="block text-sm text-slate-600 hover:text-brand.dark" href="#{{ item.id }}">{{ item.text }}</a></li>
                {% endfor %}
              </ol>
            {% else %}
              <p class="text-sm text-slate-500">—</p>
            {% endif %}
          </div>

          <!-- Share -->
          <div class="mt-6 rounded-3xl bg-white p-6 shadow-soft ring-1 ring-slate-100">
            <h4 class="font-semibold text-slate-900">Share</h4>
            <div class="mt-3 grid grid-cols-3 gap-2">
                <a id="share-x" aria-label="Share on X" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-sm hover:border-brand.light" href="#">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M18.244 3H21l-6.54 7.47L22 21h-6.2l-4.06-5.27L6.8 21H4l7.02-8.02L2 3h6.3l3.67 4.9L18.244 3Zm-1.08 16h1.68L7.92 5h-1.7l10.94 14Z"/></svg>
                
                </a>
                <a id="share-ln" aria-label="Share on LinkedIn" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-sm hover:border-brand.light" href="#">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M6.94 6.5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.5 8.75h3.5V21H3.5V8.75Zm6 0H13v1.68h.05c.49-.93 1.68-1.9 3.46-1.9 3.7 0 4.39 2.44 4.39 5.61V21h-3.5v-5.47c0-1.3-.03-2.98-1.82-2.98-1.83 0-2.11 1.43-2.11 2.9V21H9.5V8.75Z"/></svg>
                
                </a>
                <div class="relative">
                <button id="copy" aria-describedby="copy-tip" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-sm hover:border-brand.light">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M16 1H4a2 2 0 0 0-2 2v12h2V3h12V1Zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 16H8V7h11v14Z"/></svg>
                Copy
                </button>
                <span id="copy-tip" role="tooltip" class="pointer-events-none absolute left-1/2 -translate-x-1/2 -top-9 rounded-lg bg-slate-900 px-2 py-1 text-xs text-white opacity-0 translate-y-1 transition">Copied!</span>
                </div>
                </div>
          </div>

          <!-- Author -->
          <div class="mt-6 rounded-3xl bg-white p-6 shadow-soft ring-1 ring-slate-100">
            <div class="flex items-center gap-4">
              <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-brand.light/20 to-brand.dark/20">
                <img src="/assets/img/me.jpeg" alt="Omar Gastón Chalas" class="h-12 w-12 rounded-2xl object-cover"/>
              </div>
              <div>
                <p class="font-semibold text-slate-900">Omar Gastón Chalas</p>
                <p class="md:text-xs text-sm text-slate-600">Software Engineer · Cloud & AI</p>
              </div>
            </div>
            <p class="mt-3 text-sm text-slate-700">I build useful products and developer experiences across JavaScript, cloud, and AI. Writing to think better.</p>
          </div>
        </aside>
      </div>

      <!-- Newsletter CTA -->
      <section class="mx-auto mt-12 max-w-7xl">
        <div class="rounded-3xl bg-gradient-to-r from-brand.light/10 to-brand.dark/10 p-[1px] shadow-soft">
          <div class="rounded-3xl bg-white p-6 sm:p-8">
            <div class="sm:flex sm:items-center sm:justify-between gap-6">
              <div>
                <h3 class="text-xl font-bold text-slate-900">Get new posts in your inbox</h3>
                <p class="mt-1 text-slate-700">No spam. Just practical notes on engineering, cloud, and AI.</p>
              </div>
              <form class="mt-4 sm:mt-0 flex w-full sm:w-auto gap-2" onsubmit="event.preventDefault()">
                <input type="email" required placeholder="you@example.com" class="w-full sm:w-72 rounded-xl border border-slate-300 px-3 py-2 outline-none focus:ring-2 focus:ring-brand.light">
                <button class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-white font-semibold shadow-soft hover:opacity-95 transition bg-sky-600">Subscribe</button>
              </form>
            </div>
          </div>
        </div>
      </section>

      <!-- Prev/Next (computed in blog.11tydata.js if you added it) -->
      {% if prevPost or nextPost %}
      <nav class="mx-auto mt-12 max-w-7xl">
        <div class="grid gap-4 sm:grid-cols-2">
          {% if prevPost %}
          <a href="{{ prevPost.url | url }}" class="group rounded-2xl border border-slate-200 p-4 hover:border-brand.light">
            <p class="text-xs uppercase tracking-wide text-slate-500">Previous</p>
            <p class="mt-1 font-semibold text-slate-900 group-hover:underline">{{ prevPost.data.title }}</p>
          </a>
          {% endif %}
          {% if nextPost %}
          <a href="{{ nextPost.url | url }}" class="group rounded-2xl border border-slate-200 p-4 hover:border-brand.light text-right">
            <p class="text-xs uppercase tracking-wide text-slate-500">Next</p>
            <p class="mt-1 font-semibold text-slate-900 group-hover:underline">{{ nextPost.data.title }}</p>
          </a>
          {% endif %}
        </div>
      </nav>
      {% endif %}
    </main>

    {% include "partials/footer.njk" %}

    <script>
      // year in footer (client-side)
      (function(){var el=document.getElementById('year'); if(el) el.textContent=new Date().getFullYear();})();

      // Share UI
      const url = encodeURIComponent(window.location.href);
      const text = encodeURIComponent(document.title);
      document.getElementById('share-x')?.addEventListener('click', e => {
        e.preventDefault(); window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, '_blank');
      });
      document.getElementById('share-ln')?.addEventListener('click', e => {
        e.preventDefault(); window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}`, '_blank');
      });
      document.getElementById('copy')?.addEventListener('click', async e => {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(window.location.href);
          const tip = document.getElementById('copy-tip');
          tip.classList.remove('opacity-0','translate-y-1');
          tip.classList.add('opacity-100','-translate-y-0');
          setTimeout(()=>{ tip.classList.add('opacity-0','translate-y-1'); }, 1500);
        } catch {}
      });
    </script>
  </body>
</html>

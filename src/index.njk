  <section id="blog" class="mx-auto max-w-7xl px-6 pb-20">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold tracking-tight text-secondary-500">
        Latest posts
      </h2>
      <a href="/blog" class="animated-link !text-slate-900 text-sky-600">See all →</a>
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {% for post in collections.posts | head(3) %}
        <a class="group overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-slate-100 hover:-translate-y-0.5 hover:shadow-lg transition text-sky-600" href="{{ post.url }}">
          <div class="aspect-video overflow-hidden bg-slate-50">
            {% if post.data.cover %}
              <img src="{{ post.data.cover }}" alt="{{ post.data.title }}" class="h-full w-full object-cover transition group-hover:scale-105" loading="lazy"/>
            {% else %}
              <div class="h-full w-full bg-gradient-to-br from-brand.light/20 to-brand.dark/20 flex items-center justify-center">
                <svg
                  class="h-16 w-16 text-brand.dark/30"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                  <circle cx="12" cy="13" r="3"/>
                </svg>
              </div>
            {% endif %}
          </div>
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
              {{ post.data.date | readableDate }}
            </p>
            <h3 class="mt-2 font-bold text-slate-900">
              {{ post.data.title }}
            </h3>
            {% if post.data.description %}
              <p class="mt-2 text-sm text-slate-700">
                {{ post.data.description }}
              </p>
            {% else %}
              <p class="mt-2 text-sm text-slate-700">
                {{ post.templateContent | truncate(120) }}
              </p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </section>

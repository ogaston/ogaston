---
layout: layouts/page.njk
title: Blog · Omar Gastón Chalas
---

    <!-- PAGE HEADER -->
    <section class="mx-auto max-w-7xl px-6 pt-8 pb-6">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="text-sm uppercase tracking-wider text-brand.dark/90 font-semibold">Blog</p>
          <h1 class="mt-1 text-3xl sm:text-4xl font-extrabold tracking-tight text-sky-600">Articles & Notes</h1>
          <p class="mt-2 text-slate-600 max-w-2xl">Thoughts on software engineering, cloud, AI, and building products. Short, practical, and to the point.</p>
        </div>
        <!-- optional avatar -->
        <div class="hidden md:block">
          <div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-brand.light/20 to-brand.dark/20"></div>
        </div>
      </div>
    </section>

    <!-- CONTROLS -->
    <section class="mx-auto max-w-7xl px-6 pb-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <!-- search -->
        <div class="relative w-full sm:max-w-md">
          <input id="search" type="search" placeholder="Search posts…" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 pl-10 text-slate-800 shadow-soft/0 outline-none focus:ring-2 focus:ring-brand.light" />
          <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </div>
        <!-- sort -->
        <label class="flex items-center gap-2 text-sm text-slate-600">
          Sort by
          <select id="sort" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-slate-700 focus:ring-2 focus:ring-brand.light">
            <option value="new">Newest</option>
            <option value="old">Oldest</option>
            <option value="az">A → Z</option>
          </select>
        </label>
      </div>

      <!-- tags -->
      <div class="mt-4 flex flex-wrap gap-4">
        <button class="chip" data-tag="all" aria-pressed="true">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="9" cy="9" r="2"/>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
          </svg>
          All Posts
        </button>
        <button class="chip" data-tag="engineering">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
          Engineering
        </button>
        <button class="chip" data-tag="cloud">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
          </svg>
          Cloud
        </button>
        <button class="chip" data-tag="ai">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
          AI
        </button>
        <button class="chip" data-tag="career">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            <rect x="4" y="6" width="16" height="14" rx="2"/>
          </svg>
          Career
        </button>
        <button class="chip" data-tag="product">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/>
            <path d="m3 9 2.45-4.9A2 2 0 0 1 7.24 3h9.52a2 2 0 0 1 1.8 1.1L21 9"/>
            <path d="M12 3v6"/>
          </svg>
          Product
        </button>
      </div>
    </section>

    <hr class="mt-6 mb-10 border-slate-200 w-full" />

    <!-- POSTS GRID -->
    <main class="mx-auto max-w-7xl px-6 pb-20">
      <div id="posts" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {% for post in collections.posts | reverse %}
        <article class="post card group overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-slate-100" 
                 data-tags="{% for tag in post.data.tags %}{{ tag | lower }}{% if not loop.last %},{% endif %}{% endfor %}" 
                 data-title="{{ post.data.title | lower }}" 
                 data-date="{{ post.data.date | readableDate }}">
          <a href="{{ post.url }}" class="block">
            <div class="aspect-[16/9] overflow-hidden bg-slate-50">
              {% if post.data.cover %}
              <img src="{{ post.data.cover }}" alt="{{ post.data.title }}" class="h-full w-full object-cover transition group-hover:scale-105" loading="lazy" />
              {% else %}
              <div class="h-full w-full bg-gradient-to-br from-brand.light/20 to-brand.dark/20 flex items-center justify-center">
                <svg class="h-16 w-16 text-brand.dark/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                  <circle cx="12" cy="13" r="3"/>
                </svg>
              </div>
              {% endif %}
            </div>
          </a>
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-brand.dark/90">{{ post.data.date | readableDate }} • {{ post.templateContent | readingTime }}</p>
            <a href="{{ post.url }}" class="mt-1 block">
              <h2 class="font-bold text-slate-900 group-hover:underline">{{ post.data.title }}</h2>
            </a>
            {% if post.data.description %}
            <p class="mt-2 text-sm text-slate-700">{{ post.data.description }}</p>
            {% endif %}
            {% if post.data.tags %}
            <div class="mt-3 flex flex-wrap gap-2">
              {% for tag in post.data.tags %}
              <span class="chip !rounded-lg !px-2 !py-1">{{ tag }}</span>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </div>

      <!-- PAGINATION -->
      <div id="pagination" class="mt-10 flex items-center justify-between hidden">
        <button id="prev" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-slate-700 hover:border-brand.light hover:text-brand.dark disabled:opacity-40" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="m14 7-5 5 5 5V7z"/></svg>
          Newer
        </button>
        <div class="text-sm text-slate-500">Page <span id="page">1</span> of <span id="pages">1</span></div>
        <button id="next" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-slate-700 hover:border-brand.light hover:text-brand.dark">
          Older
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="m10 17 5-5-5-5v10z"/></svg>
        </button>
      </div>
    </main>



    <script>
      // Blog filtering, sorting, and pagination
      const chips = [...document.querySelectorAll('.chip[data-tag]')];
      const posts = [...document.querySelectorAll('.post')];
      const search = document.getElementById('search');
      const sortSel = document.getElementById('sort');
      const paginationEl = document.getElementById('pagination');
      const prevBtn = document.getElementById('prev');
      const nextBtn = document.getElementById('next');
      const pageEl = document.getElementById('page');
      const pagesEl = document.getElementById('pages');

      let activeTag = 'all';
      let currentPage = 1;
      const postsPerPage = 20;

      function applyFilters() {
        const q = search.value.toLowerCase().trim();
        let filteredPosts = posts.slice();

        // Filter by tag and search
        filteredPosts = filteredPosts.filter(el => {
          const tags = (el.dataset.tags || '').toLowerCase();
          const title = (el.dataset.title || '').toLowerCase();
          const inTag = activeTag === 'all' || tags.includes(activeTag.toLowerCase());
          const inText = !q || title.includes(q);
          return inTag && inText;
        });

        // Sort
        if (sortSel.value === 'new' || sortSel.value === 'old') {
          filteredPosts.sort((a, b) => {
            const da = new Date(a.dataset.date), db = new Date(b.dataset.date);
            return sortSel.value === 'new' ? db - da : da - db;
          });
        } else if (sortSel.value === 'az') {
          filteredPosts.sort((a, b) => (a.dataset.title > b.dataset.title ? 1 : -1));
        }

        // Handle pagination
        const totalPages = Math.ceil(filteredPosts.length / postsPerPage);
        const shouldShowPagination = filteredPosts.length > postsPerPage;

        // Reset to page 1 when filtering changes
        if (currentPage > totalPages) {
          currentPage = 1;
        }

        // Show/hide pagination
        paginationEl.classList.toggle('hidden', !shouldShowPagination);

        if (shouldShowPagination) {
          // Update pagination info
          pageEl.textContent = currentPage;
          pagesEl.textContent = totalPages;

          // Update button states
          prevBtn.disabled = currentPage <= 1;
          nextBtn.disabled = currentPage >= totalPages;
          
          prevBtn.classList.toggle('opacity-50', currentPage <= 1);
          nextBtn.classList.toggle('opacity-50', currentPage >= totalPages);
        }

        // Show/hide posts based on pagination
        const grid = document.getElementById('posts');
        posts.forEach(post => post.classList.add('hidden'));

        if (shouldShowPagination) {
          const startIndex = (currentPage - 1) * postsPerPage;
          const endIndex = startIndex + postsPerPage;
          const postsToShow = filteredPosts.slice(startIndex, endIndex);
          
          postsToShow.forEach(post => {
            post.classList.remove('hidden');
            grid.appendChild(post);
          });
        } else {
          filteredPosts.forEach(post => {
            post.classList.remove('hidden');
            grid.appendChild(post);
          });
        }
      }

      // Event listeners
      chips.forEach(chip => {
        chip.addEventListener('click', () => {
          chips.forEach(c => c.setAttribute('aria-pressed', 'false'));
          chip.setAttribute('aria-pressed', 'true');
          activeTag = chip.dataset.tag;
          currentPage = 1; // Reset to first page
          applyFilters();
        });
      });

      search.addEventListener('input', () => {
        currentPage = 1; // Reset to first page
        applyFilters();
      });

      sortSel.addEventListener('change', () => {
        currentPage = 1; // Reset to first page
        applyFilters();
      });

      // Pagination button handlers
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          applyFilters();
        }
      });

      nextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(posts.filter(el => {
          const tags = (el.dataset.tags || '').toLowerCase();
          const title = (el.dataset.title || '').toLowerCase();
          const q = search.value.toLowerCase().trim();
          const inTag = activeTag === 'all' || tags.includes(activeTag.toLowerCase());
          const inText = !q || title.includes(q);
          return inTag && inText;
        }).length / postsPerPage);

        if (currentPage < totalPages) {
          currentPage++;
          applyFilters();
        }
      });

      // Initialize
      applyFilters();
    </script>

